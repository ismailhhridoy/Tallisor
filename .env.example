# Copy this file to .env and fill in ONE key to let an AI model write the explanations.
# .env is private: it is in .gitignore and is never uploaded.
# Without a key, Tallisor uses fixed-rule explanations (fully offline, same result every time).

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Optional:
# TALLISOR_LLM_PROVIDER=anthropic
# TALLISOR_LLM_MODEL=claude-sonnet-5-5
