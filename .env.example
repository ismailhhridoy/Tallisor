# Copy this file to .env and fill in ONE key to let an AI model write the explanations.
# .env is private: it is in .gitignore and is never uploaded.
# Without a key, Tallisor uses fixed-rule explanations (fully offline, same result every time).

# Free option: Google Gemini. Create a key at https://aistudio.google.com/apikey (no card needed).
# Privacy: on Gemini's FREE tier Google may use prompts to improve its products and people may
# review them. Fine for the sample companies; for real customer data use a paid key.
GEMINI_API_KEY=

# Paid options:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional overrides:
# TALLISOR_LLM_PROVIDER=gemini
# TALLISOR_LLM_MODEL=gemini-3.8-flash
